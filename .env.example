# OpenLDAP dev directory. The base DN's first component must match `dc:` in
# docker/ldap/ldifs/init_org_tree.ldif (defaults to dc=icewarp,dc=local).
LDAP_ORG_DN=dc=icewarp,dc=local
LDAP_USER_BASE_DN="ou=people,dc=icewarp,dc=local
LDAP_ADMIN_DN=uid=admin,dc=icewarp,dc=local
LDAP_ADMIN_PASSWORD=password

# IceWarp dev settings. The official image obtains a 30-day trial license
ICEWARP_DOMAIN=icewarp.local
ICEWARP_URL=http://icewarp:80/icewarpapi/
ICEWARP_ADMIN_EMAIL=admin@icewarp.local
# automatically when ICEWARP_LICENSE is left unset.
# IceWarp enforces a password policy — must be strong (upper/lower/digit/symbol).
ICEWARP_ADMIN_PASSWORD=IceWarpDev2026!

# LOG_LEVEL=debug
# INTROSPECT_ICEWARP=0