# Timezone for the containers (Postgres applies it only at first init).
TZ=Europe/Vienna

# Local dev passwords — fine for localhost only, never reuse anywhere real.
POSTGRES_PASSWORD=password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=password

# IceWarp Server image. Licensed product — set this to the official image you
# have access to. The compose default is a placeholder and will not pull.
ICEWARP_IMAGE=icewarp/server:latest
