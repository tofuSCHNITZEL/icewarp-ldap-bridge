# Timezone for the containers (Postgres applies it only at first init).
TZ=Europe/Vienna

# Local dev passwords — fine for localhost only, never reuse anywhere real.
POSTGRES_PASSWORD=password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=password

# IceWarp dev settings. The official image obtains a 30-day trial license
# automatically when ICEWARP_LICENSE is left unset.
ICEWARP_IMAGE=icewarptechnology/icewarp-server:14
ICEWARP_DOMAIN=icewarp.local
# IceWarp enforces a password policy — must be strong (upper/lower/digit/symbol).
ICEWARP_ADMIN_PASSWORD=IceWarpDev2026!
ICEWARP_DB_PASSWORD=password
